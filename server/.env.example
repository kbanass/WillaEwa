PORT=3000
NODE_ENV=production
JWT_SECRET=
SERPAPI_API_KEY=
GOOGLE_PLACE_ID=
DOMAIN_NAME=willaewanadmorzem.pl
# Absolute path to the directory served by nginx (contains index.html + templates/ subdir)
CLIENT_DIR=/var/www/WillaEwa/client/dist
DB_PATH=/var/www/WillaEwa/server/data/willa-ewa.db
# Telegram notifications (errors/warns real-time + daily summary at 19:00)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Resend (HTTP API mail – Hetzner blocks outbound SMTP ports)
RESEND_API_KEY=
# Sender address must use a domain verified in Resend, e.g. "Willa Ewa <noreply@willaewanadmorzem.pl>"
MAIL_FROM=
OWNER_EMAIL=
BACKUP_EMAIL=

