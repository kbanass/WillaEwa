<style>
  .facilities {
    background-color: var(--c-bg-secondary);
  }

  .facilities__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-l);
  }

  .facilities__card {
    flex: 0 0 calc(50% - var(--space-l) / 2);
    border: 1px solid var(--c-border-light);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    justify-content: space-around;
    align-items: center;
    padding: 20px 10px;
  }

  .facilities__card-icon {
    padding: 16px;
    background-color: var(--c-bg-secondary);
    margin-bottom: var(--space-m);
    box-shadow: 0px 2px 3px 1px var(--c-font-light);
  }

  .facilities__card svg {
    color: var(--c-bg-dark);
    width: 2rem;
  }

  .facilities__card h3 {
    font-size: 1.1rem;
    font-family: var(--font-serif);
    font-weight: var(--weight-bold);
  }

  @media (min-width: 780px) {
    .facilities__card {
      flex: 0 0 calc(25% - (3 * var(--space-l)) / 4);
    }
  }
</style>
