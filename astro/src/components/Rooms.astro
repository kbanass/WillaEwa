---
import "swiper/css";
import "swiper/css/navigation";
import "swiper/css/pagination";
import "../styles/photoswipe.css";
import {
  getRoomsSlider,
  getSiteSettings,
  lightboxSources,
  urlFor,
} from "../lib/sanity";
import type { LightboxItem } from "../lib/lightbox";

const [roomsData, settings] = await Promise.all([
  getRoomsSlider(),
  getSiteSettings(),
]);

const images = (roomsData?.images ?? []).filter((img) => img.image);

const photos = images.map((img) => ({
  src: urlFor(img.image!).width(1200).auto("format").url(),
  srcset: [600, 900, 1200]
    .map((w) => `${urlFor(img.image!).width(w).auto("format").url()} ${w}w`)
    .join(", "),
  alt: img.alt ?? "",
  lqip: img.lqip ?? "",
}));

const lightboxItems: LightboxItem[] = images.map((img) => ({
  ...lightboxSources(img.image!),
  width: img.width ?? 1920,
  height: img.height ?? 1080,
  alt: img.alt ?? "",
  msrc: img.lqip || undefined,
}));
---

<section class="rooms" id="oferta">
  <div class="container">
    <div class="section-header">
      <span class="section-label"></span>
      <h2 class="section-title">Nasza oferta</h2>
      <p class="section-lead">
        Willa Ewa położona jest w spokojnej części Krynicy Morskiej, nieopodal
        malowniczego lasu. To kameralne miejsce idealne dla osób szukających
        ciszy i relaksu z dala od zgiełku, przeznaczone dla par oraz rodzin ze
        starszymi dziećmi.
      </p>
    </div>
    <div class="rooms__content">
      <div class="rooms-slider">
        {
          photos.length > 0 && (
            <div class="rooms-swiper-wrapper">
              <div
                class="swiper rooms-swiper"
                data-lightbox={JSON.stringify(lightboxItems)}
              >
                <div class="swiper-wrapper">
                  {photos.map((photo, i) => (
                    <div class="swiper-slide">
                      <button
                        class="rooms-swiper__btn"
                        data-index={i}
                        aria-label={`Otwórz zdjęcie: ${photo.alt}`}
                      >
                        <img
                          src={photo.src}
                          srcset={photo.srcset}
                          sizes="(min-width: 1024px) 620px, (min-width: 780px) 820px, 100vw"
                          alt={photo.alt}
                          loading={i === 0 ? "eager" : "lazy"}
                          class="rooms-swiper__img"
                          style={
                            photo.lqip
                              ? `background-image: url('${photo.lqip}'); background-size: cover;`
                              : ""
                          }
                        />
                      </button>
                    </div>
                  ))}
                </div>
                <div class="swiper-button-prev" />
                <div class="swiper-button-next" />
                <div class="swiper-pagination" />
              </div>
            </div>
          )
        }
      </div>
      <div class="rooms__info">
        <h3 class="rooms__info-title"></h3>
        <p>
          {
            settings?.roomsDescription ??
              `Oferujemy przytulne pokoje dwuosobowe oraz większe — dla 3-5 osób, z prywatnymi łazienkami. W każdym z nich znajduje się telewizor, lodówka i czajnik elektryczny. Do dyspozycji gości jest także duży taras na pierwszym piętrze z miejscem na grilla oraz parking na ogrodzonej posesji.`
          }
        </p>
        <div class="rooms__info-price animate slide-from-left">
          {
            settings?.priceFrom && settings?.priceTo
              ? `Od ${settings.priceFrom} do ${settings.priceTo} zł`
              : "Od 60 do 80 zł"
          }
          <small>za dobę od osoby</small>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Keyboard, A11y } from "swiper/modules";
  import { openLightbox, type LightboxItem } from "../lib/lightbox";

  const swiperEl = document.querySelector<HTMLElement>(".rooms-swiper");
  if (swiperEl) {
    const items: LightboxItem[] = JSON.parse(swiperEl.dataset.lightbox ?? "[]");

    new Swiper(swiperEl, {
      modules: [Navigation, Pagination, Keyboard, A11y],
      navigation: {
        prevEl: ".swiper-button-prev",
        nextEl: ".swiper-button-next",
      },
      pagination: {
        el: ".swiper-pagination",
        dynamicBullets: true,
        clickable: true,
      },
      keyboard: { enabled: true },
      loop: items.length > 1,
      spaceBetween: 32,
      centeredSlides: true,
      a11y: { enabled: true },
    });

    // Delegated: with loop on, Swiper clones slides, and the clones need
    // to open the lightbox too.
    swiperEl.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(
        ".rooms-swiper__btn",
      );
      if (btn) openLightbox(items, Number(btn.dataset.index ?? 0));
    });
  }
</script>

<style>
  .rooms {
    background-color: var(--c-bg-primary);
  }

  .rooms__content {
    display: grid;
    grid-template-rows: auto 1fr;
    background-color: var(--c-bg-secondary);
  }

  .rooms-slider {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .rooms__info {
    display: grid;
    grid-template-rows: min-content 1fr min-content;
    gap: var(--space-xl);
    padding: 64px 16px;
  }

  .rooms__info-title {
    font-size: var(--font-size-l);
    font-weight: var(--weight-bold);
    font-family: var(--font-serif);
  }

  .rooms__info-price {
    display: flex;
    flex-direction: column;
    text-align: right;
    font-size: var(--font-size-xl);
    font-weight: var(--weight-bold);
    font-family: var(--font-sans-serif);
    font-style: italic;
    color: var(--c-font-accent);
  }
  .rooms__info-price small {
    color: var(--c-font-primary);
    font-size: var(--font-size-m);
    font-weight: var(--weight-medium);
  }

  @media (min-width: 780px) {
    .rooms__content {
      grid-template-columns: 1.1fr 1fr;
      grid-template-rows: unset;
    }

    .rooms-slider {
      aspect-ratio: unset;
      height: 100%;
    }

    .rooms__info {
      padding: 32px;
    }
  }

  /* ── Swiper wrapper + gradients ───────────────────────────────── */

  .rooms-swiper-wrapper {
    position: absolute;
    inset: 0;
  }

  .rooms-swiper-wrapper::before,
  .rooms-swiper-wrapper::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 10;
    pointer-events: none;
  }

  .rooms-swiper-wrapper::before {
    left: 0;
    background: linear-gradient(to right, var(--c-bg-secondary), transparent);
  }

  .rooms-swiper-wrapper::after {
    right: 0;
    background: linear-gradient(to left, var(--c-bg-secondary), transparent);
  }

  /* ── Swiper internals — :global() needed for loop-cloned slides ── */

  :global(.rooms-swiper) {
    --swiper-navigation-color: #fff;
    --swiper-pagination-color: var(--c-font-light);
    position: absolute;
    inset: 0;
  }

  :global(.rooms-swiper .swiper-wrapper) {
    height: 100%;
  }

  :global(.rooms-swiper .swiper-slide) {
    height: 100%;
  }

  :global(.rooms-swiper__btn) {
    all: unset;
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }

  /* No hover/press effect at all — `all: unset` above doesn't stop the
     global button:hover inset shadow / button:active scale, since those
     are separate rules; this class+pseudo selector simply outweighs their
     type+pseudo specificity. */
  :global(.rooms-swiper__btn:hover),
  :global(.rooms-swiper__btn:active) {
    box-shadow: none;
    transform: none;
  }

  :global(.rooms-swiper__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
  }
</style>
