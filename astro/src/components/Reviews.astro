<Fragment set:html={`<script type="application/ld+json">${ldJson}</script>`} />

<script>
  const MAX_SLOTS = 6;

  type ReviewData = { id: string; size: 1 | 2 };
  type ReviewsPages = Record<number, string[]>;

  function buildReviewsPages(reviews: ReviewData[]): ReviewsPages {
    const pages: ReviewsPages = {};
    const remaining = [...reviews];
    let pageNum = 1;
    while (remaining.length > 0) {
      const pageIds: string[] = [];
      let currentSum = 0;
      const usedIndices = new Set<number>();
      let i = 0;
      while (i < remaining.length) {
        if (usedIndices.has(i)) {
          i++;
          continue;
        }
        const review = remaining[i]!;
        if (currentSum + review.size <= MAX_SLOTS) {
          pageIds.push(review.id);
          currentSum += review.size;
          usedIndices.add(i);
          i++;
          if (currentSum === MAX_SLOTS) break;
        } else {
          let foundIdx = -1;
          for (let j = i + 1; j < remaining.length; j++) {
            if (
              !usedIndices.has(j) &&
              currentSum + remaining[j]!.size === MAX_SLOTS
            ) {
              foundIdx = j;
              break;
            }
          }
          if (foundIdx !== -1) {
            pageIds.push(remaining[foundIdx]!.id);
            usedIndices.add(foundIdx);
          }
          break;
        }
      }
      for (const idx of [...usedIndices].sort((a, b) => b - a))
        remaining.splice(idx, 1);
      if (pageIds.length === 0) break;
      pages[pageNum++] = pageIds;
    }
    return pages;
  }

  const allCards = document.querySelectorAll<HTMLElement>(".review-card");
  const pageNumberEl = document.querySelector(".reviews__navigation-page");
  const navigationEl = document.querySelector(".reviews__navigation");
  const prevBtn = document.querySelector(".reviews__nav-btn--prev");
  const nextBtn = document.querySelector(".reviews__nav-btn--next");
  const reviewsSection = document.querySelector(".reviews");
  const cardMap = new Map<string, HTMLElement>();
  const reviewsData: ReviewData[] = [];

  allCards.forEach((el) => {
    const id = el.dataset.id;
    if (!id) return;
    cardMap.set(id, el);
    reviewsData.push({ id, size: el.classList.contains("long-quote") ? 2 : 1 });
  });

  const reviewsPages = buildReviewsPages(reviewsData);
  const numPages = Object.keys(reviewsPages).length;
  let currentPage = 1;

  function showPage(pageNum: number): void {
    const nextIds = new Set<string>(reviewsPages[pageNum] ?? []);
    cardMap.forEach((el) => {
      if (!el.classList.contains("hidden")) el.classList.add("is-fading");
    });
    setTimeout(() => {
      cardMap.forEach((el, id) => {
        el.classList.remove("is-fading");
        el.classList.toggle("hidden", !nextIds.has(id));
      });
      requestAnimationFrame(() => {
        nextIds.forEach((id) => {
          const el = cardMap.get(id);
          el?.classList.add("is-fading");
          requestAnimationFrame(() => el?.classList.remove("is-fading"));
        });
      });
      if (pageNumberEl) pageNumberEl.textContent = `${pageNum} / ${numPages}`;
    }, 200);
  }

  if (numPages <= 1) {
    navigationEl?.classList.add("hidden");
  } else {
    prevBtn?.addEventListener("click", () => {
      currentPage = currentPage === 1 ? numPages : currentPage - 1;
      showPage(currentPage);
      reviewsSection?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    nextBtn?.addEventListener("click", () => {
      currentPage = currentPage === numPages ? 1 : currentPage + 1;
      showPage(currentPage);
      reviewsSection?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    showPage(1);
  }

  document.querySelectorAll(".review-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const quote = btn.previousElementSibling;
      const expanded = quote?.classList.toggle("expanded");
      btn.textContent = expanded ? "Zwiń" : "Czytaj więcej";
    });
  });
</script>

<style>
  .reviews {
    background-color: var(--c-bg-secondary);
  }

  .reviews .section-header {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 780px) {
    .reviews .section-header {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .reviews__score {
    margin-top: var(--space-l);
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid var(--c-border-light);
    gap: var(--space-s);
    justify-content: space-between;
    align-items: center;
    padding: 24px;
  }

  @media (min-width: 780px) {
    .reviews__score {
      width: auto;
    }
  }

  .reviews__score h2 {
    color: var(--c-font-primary);
    font-size: 4rem;
    font-family: var(--font-serif);
    font-weight: var(--weight-medium);
    text-box-trim: trim-both;
    margin-bottom: 24px;
  }

  .reviews__score small {
    color: var(--c-font-secondary);
    font-size: var(--font-size-s);
    text-decoration: underline;
  }

  .reviews__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  @media (min-width: 780px) {
    .reviews__grid {
      display: grid;
      grid-auto-flow: row dense;
      grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    }
  }

  .review-card {
    border: 1px solid var(--c-font-accent);
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-l);
    transition: opacity 200ms ease;
  }

  .review-card.hidden {
    display: none;
  }

  .review-card.is-fading {
    display: flex;
    opacity: 0;
  }

  .review-card__source {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: start;
    font-size: var(--font-size-s);
    color: var(--c-font-secondary);
  }

  .review-card__source-logo-wrap {
    display: flex;
    flex-direction: row;
    gap: 8px;
    justify-content: center;
    align-items: center;
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
  }

  .star {
    width: 18px;
    height: 18px;
    background: var(--c-star-empty);
    clip-path: polygon(
      50% 0%,
      61% 35%,
      98% 35%,
      68% 57%,
      79% 91%,
      50% 70%,
      21% 91%,
      32% 57%,
      2% 35%,
      39% 35%
    );
  }

  .star--filled {
    background: var(--c-star);
  }

  .star--half {
    background: linear-gradient(
      to right,
      var(--c-star) 50%,
      var(--c-star-empty) 50%
    );
  }

  .review-card__quote {
    font-family: var(--font-serif);
    font-weight: var(--weight-light);
  }

  .review-card.long-quote {
    grid-column-end: span 2;
  }

  .review-card.long-quote .review-card__quote {
    overflow: hidden;
    max-height: 6.5rem;
    transition: max-height 250ms ease-out;
  }

  .review-card.long-quote .expanded {
    max-height: 1000px;
  }

  .review-card.long-quote .review-toggle {
    align-self: flex-end;
    background: none;
    border: 1px solid var(--c-font-accent);
    color: var(--c-font-accent);
    padding: 8px 16px;
    cursor: pointer;
  }

  .review-card__author {
    font-size: var(--font-size-s);
    width: 100%;
    padding-top: 16px;
    border-top: 1px solid var(--c-font-accent);
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 16px;
  }

  .review-card__name {
    font-weight: var(--weight-bold);
    text-transform: capitalize;
  }

  .review-card__date {
    font-weight: var(--weight-light);
    font-size: var(--font-size-s);
  }

  .review-card__avatar {
    background-color: hsl(32, 26%, 73%);
    color: var(--c-font-light);
    font-weight: var(--weight-medium);
    font-family: var(--font-serif);
    font-size: var(--font-size-m);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 4ch;
    aspect-ratio: 1/1;
    border-radius: 50%;
    text-transform: uppercase;
  }

  .reviews-bottom {
    margin-top: 32px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .reviews__navigation {
    display: flex;
