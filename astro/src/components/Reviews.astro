---
import { sanityClient, publicReviewsQuery } from "../lib/sanity";

interface Review {
  id: string;
  author: string;
  quote: string;
  rating: number;
  time: number;
  source: string;
}

interface Stars {
  full: number;
  half: boolean;
  empty: number;
}

let reviews: Review[] = [];
let avgRating = 5.0;

try {
  const data = await sanityClient.fetch(publicReviewsQuery);
  reviews = (data?.reviews ?? []) as Review[];
  const googleRatings: number[] = (data?.googleRatings ?? []).filter(
    (r): r is number => r !== null,
  );
  if (googleRatings.length > 0) {
    const sum = googleRatings.reduce((a: number, b: number) => a + b, 0);
    avgRating = Math.round((sum / googleRatings.length) * 10) / 10;
  }
} catch {
  // Sanity niedostępne podczas builda — pomiń opinie
}

function getInitials(author: string): string {
  return author
    .split(" ")
    .map((w) => w[0] ?? "")
    .join("")
    .slice(0, 2)
    .toLowerCase();
}

function formatDate(ts: number): string {
  return new Date(ts * 1000).toLocaleDateString("pl-PL", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function buildStars(rating: number): Stars {
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5;
  const empty = 5 - full - (half ? 1 : 0);
  return { full, half, empty };
}

const avgStars = buildStars(Math.round(avgRating * 2) / 2);

const ldSchema = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: "Willa Ewa",
  url: "https://willaewanadmorzem.pl/",
  telephone: "+48508273502",
  image: "https://willaewanadmorzem.pl/favicon/og-image.png",
  description:
    "Spokojny obiekt noclegowy w Krynicy Morskiej, nieopodal malowniczego lasu. Idealne miejsce dla par i rodzin.",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "ul. Szałwiowa 1",
    addressLocality: "Krynica Morska",
    postalCode: "82-120",
    addressCountry: "PL",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 54.371607,
    longitude: 19.4174926,
  },
  ...(reviews.length > 0 && {
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: avgRating.toFixed(1),
      reviewCount: reviews.length,
      bestRating: "5",
      worstRating: "1",
    },
    review: reviews.slice(0, 5).map((r) => ({
      "@type": "Review",
      author: { "@type": "Person", name: r.author },
      datePublished: new Date(r.time * 1000).toISOString().split("T")[0],
      reviewRating: {
        "@type": "Rating",
        ratingValue: String(r.rating),
        bestRating: "5",
        worstRating: "1",
      },
      reviewBody: r.quote,
    })),
  }),
};
// Escape </script> sequence to prevent premature tag closing in the page HTML.
const ldJson = JSON.stringify(ldSchema).replace(/<\/script>/gi, "<\\/script>");
---

