---
import {
  firstHeroSlides,
  heroSrcset,
  HERO_DESKTOP_MEDIA,
  HERO_MOBILE_MEDIA,
  type HeroSlide,
} from "../lib/hero";
import { SITE } from "../lib/site";

interface Props {
  slides: HeroSlide[];
}

const { slides } = Astro.props;
const first = firstHeroSlides(slides);

// 1×1 transparent GIF: stops the browser from fetching an initial slide's
// image on the device where that slide is not shown first.
const BLANK_IMG =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
---

<section class="hero" aria-label="Widoki z Krynicy Morskiej">
  {
    slides.map((slide, i) => {
      const firstOnMobile = i === first.mobile;
      const firstOnDesktop = i === first.desktop;
      const eager = firstOnMobile || firstOnDesktop;
      // Initial for one device only → block the fetch on the other one.
      const blockMedia =
        firstOnMobile && !firstOnDesktop
          ? HERO_DESKTOP_MEDIA
          : firstOnDesktop && !firstOnMobile
            ? HERO_MOBILE_MEDIA
            : null;
      const classes = [
        "hero__slide",
        slide.visibility === "mobile" && "hero__slide--mobile-only",
        slide.visibility === "desktop" && "hero__slide--desktop-only",
        firstOnMobile && "hero__slide--initial-mobile",
        firstOnDesktop && "hero__slide--initial-desktop",
      ]
        .filter(Boolean)
        .join(" ");
      return (
        <div
          class={classes}
          style={
            slide.lqip ? `background-image: url('${slide.lqip}')` : undefined
          }
          aria-hidden="true"
        >
          <picture>
            {blockMedia && (
              <source
                class="hero__slide-blocker"
                media={blockMedia}
                srcset={BLANK_IMG}
              />
            )}
            <img
              class="hero__slide-img"
              src={eager ? slide.midUrl : undefined}
              srcset={eager ? heroSrcset(slide) : undefined}
              sizes={eager ? "100vw" : undefined}
              data-mid={slide.midUrl}
              data-srcset={heroSrcset(slide)}
              data-full-srcset={slide.fullSrcset ?? undefined}
              data-aspect={slide.aspect.toFixed(3)}
              alt=""
              loading={eager ? "eager" : "lazy"}
              fetchpriority={eager ? "high" : undefined}
              decoding="async"
            />
          </picture>
        </div>
      );
    })
  }
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content container">
    <h1 class="hero__content-header load-slide-from-left">
      Pokoje do wynajęcia
      <br />w <em>Krynicy Morskiej</em>
    </h1>
    <a
      class="hero__content-location"
      href={SITE.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Szałwiowa 1 – otwórz lokalizację w Google Maps"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      Szałwiowa 1
    </a>
  </div>
</section>

<script>
  const allSlides = Array.from(
    document.querySelectorAll<HTMLElement>(".hero__slide"),
  );

  if (allSlides.length > 0) {
    const midLoaded = new WeakSet<Element>();
    const midPending = new Map<Element, Promise<void>>();
    const fullTried = new WeakSet<Element>();
    const fullLoaded = new WeakSet<Element>();
    let fullBusy = false;
    const INTERVAL = 5000;
    // Same breakpoint as the <style> below; slides hidden by CSS on the
    // current device (mobile-only / desktop-only) are left out of rotation.
    const desktopQuery = window.matchMedia("(min-width: 780px)");

    let slides: HTMLElement[] = [];
    let current = 0;
    let timer: number | undefined;
    // Bumped whenever the rotation restarts, so pending switches from the
    // previous rotation are dropped.
    let generation = 0;

    function shouldLoadFull(): boolean {
      return window.innerWidth * window.devicePixelRatio > 1200;
    }

    function loadMid(slide: HTMLElement): Promise<void> {
      // A slide whose full image is already on top needs no mid image.
      if (midLoaded.has(slide) || fullLoaded.has(slide)) {
        return Promise.resolve();
      }
      // Reuse a pending load: a second call would replace img.onload and the
      // first caller's promise would never resolve.
      const pending = midPending.get(slide);
      if (pending) return pending;
      const img = slide.querySelector<HTMLImageElement>(".hero__slide-img")!;
      const src = img.dataset.mid!;
      // A blocker <source> keeps the slide on a blank GIF on this device;
      // drop it so the real image loads.
      const blocker = slide.querySelector(".hero__slide-blocker");
      blocker?.remove();
      const promise = new Promise<void>((resolve) => {
        // Already loaded — e.g. first slide whose src was set in HTML and fetched
        // from the preload cache before JS ran.
        if (!blocker && img.complete && img.naturalWidth > 0) {
          midLoaded.add(slide);
          resolve();
          return;
        }
        img.onload = () => {
          midLoaded.add(slide);
          // Decode before the slide fades in, otherwise its first frames can
          // show the LQIP background instead of the loaded image.
          img
            .decode()
            .catch(() => {})
            .then(() => resolve());
        };
        img.onerror = () => resolve();
        // Let the browser pick 800px or 1200px, like for the first slide.
        if (!img.srcset) {
          img.sizes = "100vw";
          img.srcset = img.dataset.srcset!;
        }
        // Re-setting src (even unchanged) makes the browser re-pick the image
        // after the blocker is gone.
        if (blocker || img.src !== src) img.src = src;
      }).finally(() => {
        midPending.delete(slide);
        loadNextFull();
      });
      midPending.set(slide, promise);
      return promise;
    }

    // Background queue for full-resolution images: one download at a time,
    // in rotation order starting from the slide on screen. It only runs while
    // no mid image is loading, so it never slows down the next slide.
    function loadNextFull(): void {
      if (fullBusy || midPending.size > 0 || !shouldLoadFull()) return;
      for (let k = 0; k < slides.length; k++) {
        const slide = slides[(current + k) % slides.length];
        if (fullTried.has(slide)) continue;
        fullTried.add(slide);
        const img = slide.querySelector<HTMLImageElement>(".hero__slide-img")!;
        const srcset = img.dataset.fullSrcset;
        if (!srcset) continue;
        fullBusy = true;
        // Swapping src on the visible <img> leaves it blank while the large
        // image decodes, exposing the LQIP background. Instead the full image
        // goes into a separate <img> on top, added only once it is decoded,
        // so the mid image stays visible underneath until then.
        const full = new Image();
        full.className = "hero__slide-img hero__slide-img--full";
        full.alt = "";
        full.fetchPriority = "low";
        // With object-fit: cover the image is drawn at least as wide as the
        // slide and at least as tall; `sizes` is that width in CSS px, and
        // the browser picks the srcset candidate for the screen's density.
        const { width, height } = slide.getBoundingClientRect();
        const aspect = Number(img.dataset.aspect) || 1.5;
        full.sizes = `${Math.ceil(Math.max(width, height * aspect))}px`;
        full.srcset = srcset;
        full
          .decode()
          .then(() => {
            slide.appendChild(full);
            fullLoaded.add(slide);
          })
          .catch(() => {})
          .finally(() => {
            fullBusy = false;
            loadNextFull();
          });
        return;
      }
    }

    function preloadSlide(idx: number): void {
      const slide = slides[idx];
      if (slide) loadMid(slide);
    }

    function showOnly(slide: HTMLElement): void {
      for (const s of allSlides) {
        if (s !== slide) s.classList.remove("hero__slide--active");
      }
      slide.classList.add("hero__slide--active");
    }

    // Shows the current slide for INTERVAL, then waits until the next one has
    // loaded before switching. The index only advances on an actual switch,
    // so on a slow connection slides are delayed, never skipped.
    function scheduleNext(): void {
      if (slides.length < 2) return;
      const expectedGeneration = generation;
      timer = window.setTimeout(() => {
        const nextIdx = (current + 1) % slides.length;
        const next = slides[nextIdx];
        loadMid(next).then(() => {
          if (generation !== expectedGeneration) return;
          current = nextIdx;
          showOnly(next);
          // Mid of the following slide first: it is small and the rotation
          // waits for it; the full-resolution queue resumes once it is in.
          preloadSlide((current + 1) % slides.length);
          loadNextFull();
          scheduleNext();
        });
      }, INTERVAL);
    }

    // Starts the rotation from the first slide visible on this device.
    function startRotation(): void {
      const expectedGeneration = ++generation;
      clearTimeout(timer);
      slides = allSlides.filter((s) => getComputedStyle(s).display !== "none");
      current = 0;
      const first = slides[0];
      if (first) showOnly(first);
      // From now on --active decides what is visible, not the SSR classes.
      for (const s of allSlides) {
        s.classList.remove(
          "hero__slide--initial-mobile",
          "hero__slide--initial-desktop",
        );
      }
      if (!first) return;

      // First slide: browser already started fetching src from the preload cache.
      // loadMid detects img.complete and resolves immediately if it finished.
      loadMid(first).then(() => {
        if (generation !== expectedGeneration) return;
        if (slides.length > 1) preloadSlide(1);
        // Let the rest of the page load before the large downloads start.
        if ("requestIdleCallback" in window) {
          requestIdleCallback(loadNextFull, { timeout: 2000 });
        } else {
          setTimeout(loadNextFull, 500);
        }
      });
      scheduleNext();
    }

    startRotation();
    desktopQuery.addEventListener("change", startRotation);
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100dvh;
    overflow: hidden;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 500ms ease-in;
  }

  .hero__slide--active {
    opacity: 1;
    animation: slowZoom 5s ease-out forwards;
  }

  /* Breakpoint must match HERO_*_MEDIA in lib/hero.ts and the script above.
     --initial-* show the right first slide before the script runs. */
  @media (max-width: 779.98px) {
    .hero__slide--desktop-only {
      display: none;
    }

    .hero__slide--initial-mobile {
      opacity: 1;
      animation: slowZoom 5s ease-out forwards;
    }
  }

  @media (min-width: 780px) {
    .hero__slide--mobile-only {
      display: none;
    }

    .hero__slide--initial-desktop {
      opacity: 1;
      animation: slowZoom 5s ease-out forwards;
    }
  }

  .hero__slide picture {
    display: contents;
  }

  .hero__slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Created by the script, so it lacks Astro's scoping attribute. */
  .hero__slide :global(.hero__slide-img--full) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @keyframes slowZoom {
    from {
      transform: scale(1.015);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      hsla(30, 29%, 20%, 0.7) 20%,
      hsla(30, 29%, 20%, 0.5) 75%,
      transparent 100%
    );
  }

  .hero__content {
    height: 100%;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 100px;
  }

  .hero__content-header {
    grid-column: 1 / -1;
    align-self: center;
    text-align: center;
    font-family: var(--font-serif);
    color: var(--c-font-light);
    font-weight: var(--weight-normal);
    text-shadow: 1px 2px 1px var(--c-font-primary);
    font-size: var(--font-size-xxl);
    font-style: italic;
  }

  .hero__content-header em {
    color: var(--c-font-accent);
  }

  .hero__content-location {
    width: fit-content;
    align-self: self-end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    text-transform: uppercase;
    color: var(--c-font-light);
    animation: pulseLocation 2s ease-in infinite;
  }

  .hero__content-location:hover {
    animation: none;
  }

  @keyframes pulseLocation {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
</style>
