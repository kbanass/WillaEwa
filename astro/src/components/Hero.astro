---
import {
  firstHeroSlides,
  heroSrcset,
  HERO_DESKTOP_MEDIA,
  HERO_MOBILE_MEDIA,
  type HeroSlide,
} from "../lib/hero";

interface Props {
  slides: HeroSlide[];
}

const { slides } = Astro.props;
const first = firstHeroSlides(slides);

// 1×1 transparent GIF: stops the browser from fetching an initial slide's
// image on the device where that slide is not shown first.
const BLANK_IMG =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
---

<section class="hero" aria-label="Widoki z Krynicy Morskiej">
  {
    slides.map((slide, i) => {
      const firstOnMobile = i === first.mobile;
      const firstOnDesktop = i === first.desktop;
      const eager = firstOnMobile || firstOnDesktop;
      // Initial for one device only → block the fetch on the other one.
      const blockMedia =
        firstOnMobile && !firstOnDesktop
          ? HERO_DESKTOP_MEDIA
          : firstOnDesktop && !firstOnMobile
            ? HERO_MOBILE_MEDIA
            : null;
      const classes = [
        "hero__slide",
        slide.visibility === "mobile" && "hero__slide--mobile-only",
        slide.visibility === "desktop" && "hero__slide--desktop-only",
        firstOnMobile && "hero__slide--initial-mobile",
        firstOnDesktop && "hero__slide--initial-desktop",
      ]
        .filter(Boolean)
        .join(" ");
      return (
        <div
          class={classes}
          style={
            slide.lqip ? `background-image: url('${slide.lqip}')` : undefined
          }
          aria-hidden="true"
        >
          <picture>
            {blockMedia && (
              <source
                class="hero__slide-blocker"
                media={blockMedia}
                srcset={BLANK_IMG}
              />
            )}
            <img
              class="hero__slide-img"
              src={eager ? slide.midUrl : undefined}
              srcset={eager ? heroSrcset(slide) : undefined}
              sizes={eager ? "100vw" : undefined}
              data-mid={slide.midUrl}
              data-full={slide.fullUrl ?? undefined}
              alt=""
              loading={eager ? "eager" : "lazy"}
              fetchpriority={eager ? "high" : undefined}
              decoding="async"
            />
          </picture>
        </div>
      );
    })
  }
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content container">
    <h1 class="hero__content-header animate slide-from-left">
      Pokoje do wynajęcia
      <br />w <em>Krynicy Morskiej</em>
    </h1>
    <a
      class="hero__content-location"
      href="https://www.google.com/maps?cid=16206240161214872810"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Szałwiowa 1 – otwórz lokalizację w Google Maps"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      Szałwiowa 1
    </a>
  </div>
</section>

<script>
  const allSlides = Array.from(
    document.querySelectorAll<HTMLElement>(".hero__slide"),
  );

  if (allSlides.length > 0) {
    const midLoaded = new WeakSet<Element>();
    const fullRequested = new WeakSet<Element>();
    const INTERVAL = 5000;
    // Same breakpoint as the <style> below; slides hidden by CSS on the
    // current device (mobile-only / desktop-only) are left out of rotation.
    const desktopQuery = window.matchMedia("(min-width: 780px)");

    let slides: HTMLElement[] = [];
    let current = 0;
    // Bumped whenever the rotation restarts, so pending switches from the
    // previous rotation are dropped.
    let generation = 0;

    function shouldLoadFull(): boolean {
      return window.innerWidth * window.devicePixelRatio > 1200;
    }

    function loadMid(slide: HTMLElement): Promise<void> {
      if (midLoaded.has(slide)) return Promise.resolve();
      const img = slide.querySelector<HTMLImageElement>(".hero__slide-img")!;
      const src = img.dataset.mid!;
      // A blocker <source> keeps the slide on a blank GIF on this device;
      // drop it so the real image loads.
      const blocker = slide.querySelector(".hero__slide-blocker");
      blocker?.remove();
      return new Promise<void>((resolve) => {
        // Already loaded — e.g. first slide whose src was set in HTML and fetched
        // from the preload cache before JS ran.
        if (!blocker && img.complete && img.naturalWidth > 0) {
          midLoaded.add(slide);
          resolve();
          return;
        }
        img.onload = () => {
          midLoaded.add(slide);
          // Decode before the slide fades in, otherwise its first frames can
          // show the LQIP background instead of the loaded image.
          img
            .decode()
            .catch(() => {})
            .then(() => resolve());
        };
        img.onerror = () => resolve();
        // Re-setting src (even unchanged) makes the browser re-pick the image
        // after the blocker is gone.
        if (blocker || img.src !== src) img.src = src;
      });
    }

    function loadFull(slide: HTMLElement): void {
      if (fullRequested.has(slide)) return;
      const img = slide.querySelector<HTMLImageElement>(".hero__slide-img")!;
      const src = img.dataset.full;
      if (!src) return;
      const doLoad = () => {
        if (fullRequested.has(slide) || !midLoaded.has(slide)) return;
        fullRequested.add(slide);
        // Swapping src on the visible <img> leaves it blank while the large
        // image decodes, exposing the LQIP background. Instead the full image
        // goes into a separate <img> on top, added only once it is decoded,
        // so the mid image stays visible underneath until then.
        const full = new Image();
        full.className = "hero__slide-img hero__slide-img--full";
        full.alt = "";
        full.src = src;
        full
          .decode()
          .then(() => slide.appendChild(full))
          .catch(() => fullRequested.delete(slide));
      };
      if ("requestIdleCallback" in window) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).requestIdleCallback(doLoad, { timeout: 2000 });
      } else {
        setTimeout(doLoad, 500);
      }
    }

    function preloadSlide(idx: number): void {
      const slide = slides[idx];
      if (slide && !midLoaded.has(slide)) loadMid(slide);
    }

    function showOnly(slide: HTMLElement): void {
      for (const s of allSlides) {
        if (s !== slide) s.classList.remove("hero__slide--active");
      }
      slide.classList.add("hero__slide--active");
    }

    // Starts the rotation from the first slide visible on this device.
    function startRotation(): void {
      generation++;
      slides = allSlides.filter((s) => getComputedStyle(s).display !== "none");
      current = 0;
      const first = slides[0];
      if (first) showOnly(first);
      // From now on --active decides what is visible, not the SSR classes.
      for (const s of allSlides) {
        s.classList.remove(
          "hero__slide--initial-mobile",
          "hero__slide--initial-desktop",
        );
      }
      if (!first) return;

      // First slide: browser already started fetching src from the preload cache.
      // loadMid detects img.complete and resolves immediately if it finished.
      loadMid(first).then(() => {
        if (shouldLoadFull()) loadFull(first);
      });
      if (slides.length > 1) setTimeout(() => preloadSlide(1), INTERVAL - 1500);
    }

    startRotation();
    desktopQuery.addEventListener("change", startRotation);

    setInterval(() => {
      if (slides.length < 2) return;
      const nextIdx = (current + 1) % slides.length;
      current = nextIdx;

      const next = slides[nextIdx];
      const expectedGeneration = generation;

      const doSwitch = () => {
        if (generation !== expectedGeneration || current !== nextIdx) return;
        showOnly(next);
        if (shouldLoadFull()) loadFull(next);
        setTimeout(
          () => preloadSlide((current + 1) % slides.length),
          INTERVAL - 1500,
        );
      };

      if (midLoaded.has(next)) {
        doSwitch();
      } else {
        loadMid(next).then(doSwitch);
      }
    }, INTERVAL);
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100dvh;
    overflow: hidden;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 500ms ease-in;
  }

  .hero__slide--active {
    opacity: 1;
    animation: slowZoom 5s ease-out forwards;
  }

  /* Breakpoint must match HERO_*_MEDIA in lib/hero.ts and the script above.
     --initial-* show the right first slide before the script runs. */
  @media (max-width: 779.98px) {
    .hero__slide--desktop-only {
      display: none;
    }

    .hero__slide--initial-mobile {
      opacity: 1;
      animation: slowZoom 5s ease-out forwards;
    }
  }

  @media (min-width: 780px) {
    .hero__slide--mobile-only {
      display: none;
    }

    .hero__slide--initial-desktop {
      opacity: 1;
      animation: slowZoom 5s ease-out forwards;
    }
  }

  .hero__slide picture {
    display: contents;
  }

  .hero__slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Created by the script, so it lacks Astro's scoping attribute. */
  .hero__slide :global(.hero__slide-img--full) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @keyframes slowZoom {
    from {
      transform: scale(1.015);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      hsla(30, 29%, 20%, 0.7) 20%,
      hsla(30, 29%, 20%, 0.5) 75%,
      transparent 100%
    );
  }

  .hero__content {
    height: 100%;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 100px;
  }

  .hero__content-header {
    grid-column: 1 / -1;
    align-self: center;
    text-align: center;
    font-family: var(--font-serif);
    color: var(--c-font-light);
    font-weight: var(--weight-normal);
    text-shadow: 1px 2px 1px var(--c-font-primary);
    font-size: var(--font-size-xxl);
    font-style: italic;
  }

  .hero__content-header em {
    color: var(--c-font-accent);
  }

  .hero__content-location {
    width: fit-content;
    align-self: self-end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    text-transform: uppercase;
    color: var(--c-font-light);
    animation: pulseLocation 2s ease-in infinite;
  }

  .hero__content-location:hover {
    animation: none;
  }

  @keyframes pulseLocation {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
</style>
