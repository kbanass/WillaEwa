---
import "photoswipe/dist/photoswipe.css";
import { getGallery, urlFor } from "../lib/sanity";

const galleryData = await getGallery();
const items = (galleryData?.images ?? [])
  .filter((img) => img.image)
  .map((img) => ({
    _key: img._key ?? "",
    alt: img.alt ?? "",
    caption: img.caption ?? "",
    captionUrl: img.captionUrl ?? "",
    lqip: img.lqip ?? "",
    thumbSrc: urlFor(img.image!)
      .width(800)
      .height(533)
      .fit("crop")
      .auto("format")
      .url(),
    mainSrc: urlFor(img.image!).width(1920).auto("format").url(),
    zoomSrc: urlFor(img.image!).width(3840).auto("format").url(),
    width: img.width ?? 1920,
    height: img.height ?? 1080,
  }));

const preview = items.slice(0, 5);
---

<section class="gallery">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Galeria</span>
      <h2 class="section-title animate fade-in">Odkryj piękno okolicy</h2>
    </div>

    {
      items.length > 0 ? (
        <>
          <div class="gallery__grid animate stagger">
            {preview.map((img, i) => (
              <img
                src={img.thumbSrc}
                alt={img.alt}
                loading={i === 0 ? "eager" : "lazy"}
                class={i === 0 ? "gallery__grid-main" : ""}
                style={
                  img.lqip
                    ? `background-image: url('${img.lqip}'); background-size: cover;`
                    : ""
                }
                data-pswp-index={i}
              />
            ))}
          </div>
          <div class="justify-right-wrapper">
            <button
              class="gallery__open-btn button-outline"
              id="gallery-open-all"
            >
              Pokaż wszystkie
            </button>
          </div>
        </>
      ) : (
        <p style="color: var(--c-font-secondary)">Brak zdjęć w galerii.</p>
      )
    }
  </div>
</section>

<div
  id="gallery-data"
  data-items={JSON.stringify(items)}
  style="display:none"
  aria-hidden="true"
>
</div>

<script>
  import PhotoSwipe from "photoswipe";

  type GalleryItem = {
    _key: string;
    alt: string;
    caption: string;
    captionUrl: string;
    lqip: string;
    thumbSrc: string;
    mainSrc: string;
    zoomSrc: string;
    width: number;
    height: number;
  };

  const dataEl = document.getElementById("gallery-data");
  const allItems: GalleryItem[] = JSON.parse(
    dataEl?.dataset.items ?? "[]",
  );

  const DOWNLOAD_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"/><path d="M7 11l5 5l5 -5"/><path d="M12 4l0 12"/></svg>`;

  async function downloadImage(src: string): Promise<void> {
    const filename = `willa-ewa-${Date.now()}.jpg`;
    try {
      const response = await fetch(`/api/download-image?url=${encodeURIComponent(src)}`);
      const blob = await response.blob();
      const file = new File([blob], filename, { type: blob.type || "image/jpeg" });
      if (navigator.canShare?.({ files: [file] })) {
        await navigator.share({ files: [file] });
        return;
      }
    } catch (err) {
      if ((err as Error).name === "AbortError") return;
    }
    // fallback dla desktop
    const a = document.createElement("a");
    a.href = `/api/download-image?url=${encodeURIComponent(src)}`;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  if (allItems.length > 0) {
    const dataSource = allItems.map((img) => ({
      src: img.mainSrc,
      width: img.width,
      height: img.height,
      msrc: img.lqip || undefined,
      alt: img.alt,
      caption: img.caption,
      captionUrl: img.captionUrl,
      zoomSrc: img.zoomSrc,
    }));

    let pswp: PhotoSwipe | null = null;

    function openGallery(startIndex: number) {
      pswp?.destroy();
      pswp = new PhotoSwipe({
        dataSource,
        index: startIndex,
        bgOpacity: 0.88,
        wheelToZoom: true,
        zoom: true,
        close: true,
        counter: true,
        arrowKeys: true,
        preload: [1, 1],
        padding: { top: 48, bottom: 80, left: 48, right: 48 },
        imageClickAction: "zoom",
        tapAction: "zoom",
        bgClickAction: "close",
        clickToCloseNonZoomable: false,
        secondaryZoomLevel: (zl) => Math.max(zl.fit * 2, zl.fill),
        maxZoomLevel: (zl) => Math.max(zl.fit * 4, 4),
      });

      pswp.on("uiRegister", () => {
        pswp!.ui!.registerElement({
          name: "download-button",
          order: 8,
          isButton: true,
          appendTo: "bar",
          html: DOWNLOAD_ICON,
          title: "Pobierz zdjęcie",
          onClick: () => {
            const data = dataSource[pswp!.currIndex];
            if (data) downloadImage(data.src);
          },
        });

        pswp!.ui!.registerElement({
          name: "gallery-caption",
          order: 9,
          isButton: false,
          appendTo: "wrapper",
          onInit(el) {
            function positionCaption() {
              const imgEl = pswp!.currSlide?.content?.element as HTMLElement | null;
              if (!imgEl || el.style.display === "none") return;
              const imgRect = imgEl.getBoundingClientRect();
              const clampedTop = Math.min(imgRect.bottom + 10, window.innerHeight - 80);
              el.style.bottom = "auto";
              el.style.top = `${clampedTop}px`;
            }

            function updateCaption() {
              const data = dataSource[pswp!.currIndex];
              if (!data) return;
              if (data.caption) {
                el.innerHTML = data.captionUrl
                  ? `<a href="${data.captionUrl}" target="_blank" rel="noopener noreferrer">${data.caption}</a>`
                  : data.caption;
                el.style.display = "";
                setTimeout(positionCaption, 80);
              } else {
                el.style.display = "none";
              }
            }

            pswp!.on("change", updateCaption);
            pswp!.on("zoomPanUpdate", positionCaption);
          },
        });
      });

      const loadedHighRes = new Set<number>();
      pswp.on("zoomPanUpdate", ({ slide }) => {
        const idx = slide.index;
        if (loadedHighRes.has(idx)) return;
        const initialZoom = slide.zoomLevels?.initial ?? 1;
        if (slide.currZoomLevel <= initialZoom * 1.2) return;
        const data = dataSource[idx];
        if (!data?.zoomSrc) return;
        loadedHighRes.add(idx);
        const hi = new window.Image();
        hi.onload = () => {
          const imgEl = slide.content.element as HTMLImageElement | null;
          if (imgEl?.tagName === "IMG" && imgEl.src !== data.zoomSrc)
            imgEl.src = data.zoomSrc;
        };
        hi.src = data.zoomSrc;
      });

      pswp.on("destroy", () => {
        pswp = null;
      });
      pswp.init();
    }

    document
      .querySelectorAll<HTMLImageElement>(".gallery__grid img")
      .forEach((img) => {
        img.style.cursor = "zoom-in";
        img.addEventListener("click", () => {
          const idx = parseInt(img.dataset.pswpIndex ?? "0", 10);
          openGallery(idx);
        });
      });

    document
      .getElementById("gallery-open-all")
      ?.addEventListener("click", () => openGallery(0));
  }
</script>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .gallery__grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition:
      opacity 200ms,
      transform 200ms;
    display: block;
  }

  .gallery__grid img:hover {
    opacity: 0.92;
    transform: scale(0.99);
  }

  .gallery__grid-main {
    aspect-ratio: unset;
    height: 100%;
    grid-row: span 2;
  }

  @media (min-width: 780px) {
    .gallery__grid {
      grid-template-columns: 1.5fr 1fr 1fr;
      grid-template-rows: 240px 240px;
    }

    .gallery__grid img {
      aspect-ratio: unset;
      height: 100%;
    }
  }

  .gallery__open-btn {
    margin-block-start: 16px;
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-font-accent);
    color: var(--c-font-accent);
    padding: 8px 16px;
  }

  :global(.pswp__gallery-caption) {
    position: absolute;
    top: 0; /* overridden by JS to sit just below the image */
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-serif);
    font-size: var(--font-size-m);
    color: #fff;
    text-align: center;
    max-width: min(80vw, 480px);
    background: rgba(0, 0, 0, 0.45);
    padding: 6px 14px;
    pointer-events: none;
    z-index: 100;
  }

  :global(.pswp__gallery-caption a) {
    color: inherit;
    text-decoration: underline;
    pointer-events: all;
  }

  :global(.pswp__button--download-button) {
    color: var(--pswp-icon-color, #fff);
  }
</style>
