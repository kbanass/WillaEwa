---
import "../styles/photoswipe.css";
import type { SanityImageSource } from "@sanity/image-url";
import { getGallery, lightboxSources, urlFor } from "../lib/sanity";
import type { LightboxItem } from "../lib/lightbox";

// 3:2 crop, matching the grid tiles.
function galleryThumb(image: SanityImageSource, width: number): string {
  return urlFor(image)
    .width(width)
    .height(Math.round((width * 2) / 3))
    .fit("crop")
    .auto("format")
    .url();
}

const galleryData = await getGallery();
const images = (galleryData?.images ?? []).filter((img) => img.image);

// The grid shows the first five; the lightbox has all of them.
const preview = images.slice(0, 5).map((img) => ({
  src: galleryThumb(img.image!, 800),
  srcset: [400, 800, 1200]
    .map((w) => `${galleryThumb(img.image!, w)} ${w}w`)
    .join(", "),
  alt: img.alt ?? "",
  lqip: img.lqip ?? "",
}));

const lightboxItems: LightboxItem[] = images.map((img) => ({
  ...lightboxSources(img.image!),
  width: img.width ?? 1920,
  height: img.height ?? 1080,
  alt: img.alt ?? "",
  msrc: img.lqip || undefined,
  caption: img.caption || undefined,
  captionUrl: img.captionUrl || undefined,
}));
---

<section
  class="gallery"
  id="galeria"
  data-lightbox={JSON.stringify(lightboxItems)}
>
  <div class="container">
    <div class="section-header">
      <span class="section-label">Galeria</span>
      <h2 class="section-title animate fade-in">Odkryj piękno okolicy</h2>
    </div>

    {
      preview.length > 0 ? (
        <>
          <div class="gallery__grid animate stagger">
            {preview.map((img, i) => (
              <img
                src={img.src}
                srcset={img.srcset}
                sizes={
                  i === 0
                    ? "(min-width: 780px) 704px, 100vw"
                    : "(min-width: 780px) 348px, 48vw"
                }
                alt={img.alt}
                loading={i === 0 ? "eager" : "lazy"}
                class={i === 0 ? "gallery__grid-main" : ""}
                style={
                  img.lqip
                    ? `background-image: url('${img.lqip}'); background-size: cover;`
                    : ""
                }
                data-pswp-index={i}
              />
            ))}
          </div>
          <div class="justify-right-wrapper">
            <button
              class="gallery__open-btn button-outline"
              id="gallery-open-all"
            >
              Pokaż wszystkie
            </button>
          </div>
        </>
      ) : (
        <p class="section-lead">Brak zdjęć w galerii.</p>
      )
    }
  </div>
</section>

<script>
  import { openLightbox, type LightboxItem } from "../lib/lightbox";

  const gallery = document.getElementById("galeria");
  const items: LightboxItem[] = JSON.parse(gallery?.dataset.lightbox ?? "[]");

  if (gallery && items.length > 0) {
    gallery
      .querySelectorAll<HTMLImageElement>(".gallery__grid img")
      .forEach((img) => {
        img.addEventListener("click", () =>
          openLightbox(items, Number(img.dataset.pswpIndex ?? 0)),
        );
      });

    document
      .getElementById("gallery-open-all")
      ?.addEventListener("click", () => openLightbox(items));
  }
</script>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .gallery__grid img {
    cursor: zoom-in;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition:
      opacity 200ms,
      transform 200ms;
    display: block;
  }

  .gallery__grid img:hover {
    opacity: 0.92;
    transform: scale(0.99);
  }

  .gallery__grid-main {
    aspect-ratio: unset;
    height: 100%;
    grid-row: span 2;
  }

  @media (min-width: 780px) {
    .gallery__grid {
      grid-template-columns: 1.5fr 1fr 1fr;
      grid-template-rows: 240px 240px;
    }

    .gallery__grid img {
      aspect-ratio: unset;
      height: 100%;
    }
  }

  .gallery__open-btn {
    margin-block-start: 16px;
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-font-accent);
    color: var(--c-font-accent);
    padding: 8px 16px;
  }
</style>
