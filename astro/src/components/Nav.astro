---
import HeaderContact, { type HeaderLink } from "./HeaderContact.astro";

interface Props {
  phone: string;
  link: HeaderLink;
}

const { phone, link } = Astro.props;
---

<button
  class="nav__toggle load-fade-in"
  id="nav-toggle"
  type="button"
  aria-expanded="false"
  aria-controls="nav-menu"
  aria-label="Otwórz menu"
>
  <span class="nav__toggle-bar"></span>
  <span class="nav__toggle-bar"></span>
  <span class="nav__toggle-bar"></span>
</button>

<nav class="nav load-fade-in" id="nav-menu">
  <ul class="nav__links load-slide-from-left">
    <li><a href="/#oferta">Oferta</a></li>
    <li><a href="/#galeria">Galeria</a></li>
    <li><a href="/#opinie">Opinie</a></li>
    <li><a href="/#mapa">Mapa</a></li>
    <li><a href="/#informacje">Ważne informacje</a></li>
    <li><a href="/#kontakt">Kontakt</a></li>
  </ul>

  <HeaderContact phone={phone} link={link} />
</nav>

<script>
  const navToggle = document.getElementById("nav-toggle");
  const navMenu = document.getElementById("nav-menu");
  if (navToggle && navMenu) {
    const closeNav = () => {
      navMenu.classList.remove("nav--open");
      navToggle.setAttribute("aria-expanded", "false");
    };
    navToggle.addEventListener("click", () => {
      const isOpen = navMenu.classList.toggle("nav--open");
      navToggle.setAttribute("aria-expanded", String(isOpen));
    });
    navMenu
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", closeNav));
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (!navMenu.contains(target) && !navToggle.contains(target)) {
        closeNav();
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeNav();
    });
  }
</script>

<style>
  .nav__toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--c-font-primary);
    color: var(--c-font-primary);
  }

  /* Hamburger <-> X: three bars, animated purely off the aria-expanded
     state the toggle script already sets — no extra JS needed. */
  .nav__toggle-bar {
    position: absolute;
    left: 50%;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transform: translate(-50%, 0);
    transition:
      top 250ms ease,
      transform 250ms ease,
      opacity 200ms ease;
  }

  .nav__toggle-bar:nth-child(1) {
    top: 13px;
  }

  .nav__toggle-bar:nth-child(2) {
    top: 19px;
  }

  .nav__toggle-bar:nth-child(3) {
    top: 25px;
  }

  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(1) {
    top: 19px;
    transform: translate(-50%, 0) rotate(45deg);
  }

  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(3) {
    top: 19px;
    transform: translate(-50%, 0) rotate(-45deg);
  }

  /* Mobile: a dropdown panel anchored to the fixed .header, holding both the
     nav links and (at its bottom) the same phone block used on desktop —
     one markup instance, repositioned per breakpoint instead of duplicated. */
  .nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    background: hsla(30, 40%, 95%, 0.95);
    border-bottom: 1px solid var(--c-bg-accent);
    max-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition:
      max-height 250ms ease,
      visibility 250ms;
  }

  .nav--open {
    max-height: 80vh;
    visibility: visible;
    overflow-y: auto;
  }

  .nav__links {
    list-style: none;
    margin: 0;
    padding: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .nav__links a {
    font-family: var(--font-sans-serif);
    font-weight: var(--weight-normal);
    color: var(--c-font-primary);
    font-size: var(--font-size-m);
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .nav :global(.header__phone) {
    border-top: 1px solid var(--c-border-light);
    padding: var(--space-l);
    align-items: flex-start;
    text-align: left;
  }

  @media (min-width: 1024px) {
    .nav__toggle {
      display: none;
    }

    .nav {
      position: static;
      max-height: none;
      visibility: visible;
      overflow: visible;
      background: none;
      border-bottom: none;
      flex-direction: row;
      align-items: center;
      gap: var(--space-xxl);
    }

    .nav__links {
      flex-direction: row;
      padding: 0;
      gap: var(--space-xl);
    }

    .nav :global(.header__phone) {
      padding: 0;
      align-items: flex-end;
      text-align: right;
      border-top: none;
    }
  }

  @media (min-width: 1024px) and (hover: hover) {
    .nav__links a:hover {
      color: var(--c-font-accent);
    }
  }
</style>
