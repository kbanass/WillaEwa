---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Rooms from "../components/Rooms.astro";
import Facilities from "../components/Facilities.astro";
import PhoneBanner from "../components/PhoneBanner.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import Location from "../components/Location.astro";
import ImportantInfo from "../components/ImportantInfo.astro";
import Booking from "../components/Booking.astro";
import { sanityClient, heroImagesQuery } from "../lib/sanity";
import {
  buildHeroSlides,
  firstHeroSlides,
  heroSrcset,
  HERO_DESKTOP_MEDIA,
  HERO_MOBILE_MEDIA,
} from "../lib/hero";

const hero = await sanityClient.fetch(heroImagesQuery);
const heroSlides = buildHeroSlides(hero);
const first = firstHeroSlides(heroSlides);

// Preload the first slide for each device. When both devices start with the
// same slide a single preload without `media` covers both.
const heroPreloads: Array<{ index: number; media?: string }> =
  first.mobile === first.desktop
    ? first.mobile >= 0
      ? [{ index: first.mobile }]
      : []
    : [
        ...(first.mobile >= 0
          ? [{ index: first.mobile, media: HERO_MOBILE_MEDIA }]
          : []),
        ...(first.desktop >= 0
          ? [{ index: first.desktop, media: HERO_DESKTOP_MEDIA }]
          : []),
      ];
---

<BaseLayout title="Willa Ewa — Krynica Morska" showNav>
  <Fragment slot="head">
    {
      heroPreloads.map(({ index, media }) => (
        <link
          rel="preload"
          as="image"
          href={heroSlides[index].midUrl}
          imagesrcset={heroSrcset(heroSlides[index])}
          imagesizes="100vw"
          media={media}
          fetchpriority="high"
        />
      ))
    }
  </Fragment>
  <Hero slides={heroSlides} />
  <Rooms />
  <Facilities />
  <PhoneBanner />
  <Gallery />
  <Reviews />
  <Location />
  <ImportantInfo />
  <Booking />
</BaseLayout>
