---
import "../styles/variables.css";
import "../styles/reset.css";
import "../styles/style.css";
import "../styles/style-login.css";
import "../styles/style-opinie.css";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Willa Ewa – spokojny obiekt noclegowy w Krynicy Morskiej."
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="WillaEwa" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <meta name="robots" content="noindex" />

    <title>Dodaj opinię – Willa Ewa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="header">
      <div class="header__content container">
        <h3 class="header__title">Dodaj opinię</h3>
        <a class="header__link" href="/">
          <h4>Strona główna</h4>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M9 15l6 -6"></path>
            <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464"></path>
            <path
              d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463"
            ></path>
          </svg>
        </a>
      </div>
    </header>

    <section class="login add-review">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Twoja opinia</span>
          <h2 class="section-title">
            Napisz, co myślisz o swoim pobycie w Willi Ewa
          </h2>
          <p class="section-lead"></p>
        </div>

        <form class="add-review__form">
          <fieldset class="add-review__field add-review__field--stars">
            <legend class="add-review__label">
              Ocena <span class="add-review__required" aria-hidden="true"
                >*</span
              >
            </legend>
            <div class="star-picker">
              <input type="radio" id="star5" name="rating" value="5" />
              <label for="star5" aria-label="5 gwiazdek">★</label>
              <input type="radio" id="star4" name="rating" value="4" />
              <label for="star4" aria-label="4 gwiazdki">★</label>
              <input type="radio" id="star3" name="rating" value="3" />
              <label for="star3" aria-label="3 gwiazdki">★</label>
              <input type="radio" id="star2" name="rating" value="2" />
              <label for="star2" aria-label="2 gwiazdki">★</label>
              <input type="radio" id="star1" name="rating" value="1" />
              <label for="star1" aria-label="1 gwiazdka">★</label>
            </div>
          </fieldset>

          <div class="add-review__field">
            <label class="add-review__label" for="author">
              Imię i nazwisko <span
                class="add-review__required"
                aria-hidden="true">*</span
              >
            </label>
            <input
              type="text"
              id="author"
              name="author"
              placeholder="Jan Kowalski"
              autocomplete="name"
              required
            />
          </div>

          <div class="add-review__field">
            <label class="add-review__label" for="content">
              Opinia <span class="add-review__required" aria-hidden="true"
                >*</span
              >
            </label>
            <textarea
              id="content"
              name="content"
              placeholder="Miejsce na Twoją opinię."
              rows="5"
              required></textarea>
          </div>

          <div class="add-review__field">
            <label class="add-review__label" for="email">
              E-mail <span class="add-review__optional">(opcjonalnie)</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="jan@example.com"
              autocomplete="email"
            />
          </div>

          <input
            type="text"
            name="website"
            class="add-review__honeypot"
            tabindex="-1"
            autocomplete="off"
          />

          <button type="submit">Dodaj opinię</button>
          <p class="error"></p>
        </form>
      </div>
    </section>

    <footer class="footer">
      <div class="container">
        <div class="footer__grid">
          <div class="footer__brand">
            <p class="footer__brand-name">Willa Ewa</p>
            <p class="footer__brand-desc">
              Obiekt noclegowy na Mierzei Wiślanej. Stworzony dla tych, którzy
              szukają ciszy, przestrzeni i prawdziwego wypoczynku z dala od
              zgiełku.
            </p>
          </div>
          <div class="footer__address">
            <p class="footer__address-title">Adres</p>
            <address>
              ul. Szałwiowa 1<br />
              82-120 Krynica Morska<br />
              woj. pomorskie
            </address>
          </div>
          <div class="footer__contact">
            <p class="footer__contact-title">Kontakt</p>
            <p>Nr telefonu:</p>
            <a class="footer__phone" href="tel:+48508273502">+48 508 273 502</a>
          </div>
        </div>
        <div class="footer__bottom">
          <span>2025 Willa Ewa · Krynica Morska</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  const SUBMITTED_KEY = "review_submitted";

  const form = document.querySelector<HTMLFormElement>(".add-review__form")!;
  const errorEl = form.querySelector<HTMLParagraphElement>(".error")!;
  const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

  function hasSubmitted() {
    if (localStorage.getItem(SUBMITTED_KEY) === "1") return true;
    return document.cookie
      .split(";")
      .some((c) => c.trim().startsWith(`${SUBMITTED_KEY}=1`));
  }

  function markSubmitted() {
    localStorage.setItem(SUBMITTED_KEY, "1");
    const year = 60 * 60 * 24 * 365;
    document.cookie = `${SUBMITTED_KEY}=1; max-age=${year}; path=/opinie; SameSite=Strict`;
  }

  function showSentState() {
    form.querySelectorAll<HTMLInputElement | HTMLButtonElement>("input, textarea, button").forEach((el) => {
      el.disabled = true;
    });
    submitBtn.textContent = "Wysłano";
    form.classList.add("add-review__form--sent");
    const sectionHeader = document.querySelector(".add-review .section-header");
    if (sectionHeader) {
      sectionHeader.innerHTML = `
        <span class="section-label">Dziękujemy</span>
        <h2 class="section-title">Dziękujemy za opinię!</h2>
        <p class="section-lead">Po weryfikacji przez administratora pojawi się na stronie głównej.</p>
      `;
    }
  }

  if (hasSubmitted()) showSentState();

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.textContent = "";

    const author = form.querySelector<HTMLInputElement>('input[name="author"]')!.value.trim();
    const content = form.querySelector<HTMLTextAreaElement>('textarea[name="content"]')!.value.trim();
    const rating = form.querySelector<HTMLInputElement>('input[name="rating"]:checked')?.value;
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')!.value.trim();
    const website = form.querySelector<HTMLInputElement>('input[name="website"]')!.value;

    if (!rating) {
      errorEl.textContent = "Wybierz ocenę";
      return;
    }
    if (author.length < 2) {
      errorEl.textContent = "Imię i nazwisko musi mieć co najmniej 2 znaki";
      return;
    }
    if (content.length < 2) {
      errorEl.textContent = "Opinia musi mieć co najmniej 2 znaki";
      return;
    }

    submitBtn.disabled = true;

    try {
      const res = await fetch("/api/add-review", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          author,
          content,
          rating: Number(rating),
          email: email || undefined,
          website,
        }),
      });
      const data = (await res.json()) as { error?: string };
      if (res.ok) {
        markSubmitted();
        showSentState();
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else {
        errorEl.textContent = data.error ?? "Wystąpił błąd, spróbuj ponownie";
        submitBtn.disabled = false;
      }
    } catch {
      errorEl.textContent = "Błąd połączenia z serwerem";
      submitBtn.disabled = false;
    }
  });
</script>
