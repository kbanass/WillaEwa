---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Dodaj opinię – Willa Ewa"
  navigation={{ title: "Dodaj opinię", link: "main-page" }}
>
  <meta name="robots" content="noindex" slot="head" />

  <section class="form-page add-review">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Twoja opinia</span>
        <h2 class="section-title">
          Napisz, co myślisz o swoim pobycie w Willi Ewa
        </h2>
      </div>

      <form class="add-review__form">
        <fieldset class="form-field">
          <legend class="form-label">
            Ocena <span class="form-required" aria-hidden="true"
              >*</span
            >
          </legend>
          <div class="star-picker">
            <input type="radio" id="star5" name="rating" value="5" />
            <label for="star5" aria-label="5 gwiazdek">★</label>
            <input type="radio" id="star4" name="rating" value="4" />
            <label for="star4" aria-label="4 gwiazdki">★</label>
            <input type="radio" id="star3" name="rating" value="3" />
            <label for="star3" aria-label="3 gwiazdki">★</label>
            <input type="radio" id="star2" name="rating" value="2" />
            <label for="star2" aria-label="2 gwiazdki">★</label>
            <input type="radio" id="star1" name="rating" value="1" />
            <label for="star1" aria-label="1 gwiazdka">★</label>
          </div>
        </fieldset>

        <div class="form-field">
          <label class="form-label" for="author">
            Imię i nazwisko <span
              class="form-required"
              aria-hidden="true">*</span
            >
          </label>
          <input
            class="form-input"
            type="text"
            id="author"
            name="author"
            placeholder="Jan Kowalski"
            autocomplete="name"
            required
          />
        </div>

        <div class="form-field">
          <label class="form-label" for="content">
            Opinia <span class="form-required" aria-hidden="true"
              >*</span
            >
          </label>
          <textarea
            class="form-input"
            id="content"
            name="content"
            placeholder="Miejsce na Twoją opinię."
            rows="5"
            required></textarea>
        </div>

        <div class="form-field">
          <label class="form-label" for="email">
            E-mail <span class="form-optional">(opcjonalnie)</span>
          </label>
          <input
            class="form-input"
            type="email"
            id="email"
            name="email"
            placeholder="jan@example.com"
            autocomplete="email"
          />
        </div>

        <input
          type="text"
          name="website"
          class="form-honeypot"
          tabindex="-1"
          autocomplete="off"
        />

        <button type="submit" class="form-submit">Dodaj opinię</button>
        <p class="form-error"></p>
      </form>
    </div>
  </section>

  <script>
    const SUBMITTED_KEY = "review_submitted";

    const form = document.querySelector<HTMLFormElement>(".add-review__form")!;
    const errorEl = form.querySelector<HTMLParagraphElement>(".form-error")!;
    const submitBtn = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!;

    function hasSubmitted() {
      if (localStorage.getItem(SUBMITTED_KEY) === "1") return true;
      return document.cookie
        .split(";")
        .some((c) => c.trim().startsWith(`${SUBMITTED_KEY}=1`));
    }

    function markSubmitted() {
      localStorage.setItem(SUBMITTED_KEY, "1");
      const year = 60 * 60 * 24 * 365;
      document.cookie = `${SUBMITTED_KEY}=1; max-age=${year}; path=/opinie; SameSite=Strict`;
    }

    function showSentState() {
      form
        .querySelectorAll<HTMLInputElement | HTMLButtonElement>(
          "input, textarea, button",
        )
        .forEach((el) => {
          el.disabled = true;
        });
      submitBtn.textContent = "Wysłano";
      form.classList.add("add-review__form--sent");
      const sectionHeader = document.querySelector(".add-review .section-header");
      if (sectionHeader) {
        sectionHeader.innerHTML = `
          <span class="section-label">Dziękujemy</span>
          <h2 class="section-title">Dziękujemy za opinię!</h2>
          <p class="section-lead">Po weryfikacji przez administratora pojawi się na stronie głównej.</p>
        `;
      }
    }

    if (hasSubmitted()) showSentState();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.textContent = "";

      const author = form
        .querySelector<HTMLInputElement>('input[name="author"]')!
        .value.trim();
      const content = form
        .querySelector<HTMLTextAreaElement>('textarea[name="content"]')!
        .value.trim();
      const rating = form.querySelector<HTMLInputElement>(
        'input[name="rating"]:checked',
      )?.value;
      const email = form
        .querySelector<HTMLInputElement>('input[name="email"]')!
        .value.trim();
      const website = form.querySelector<HTMLInputElement>(
        'input[name="website"]',
      )!.value;

      if (!rating) {
        errorEl.textContent = "Wybierz ocenę";
        return;
      }
      if (author.length < 2) {
        errorEl.textContent = "Imię i nazwisko musi mieć co najmniej 2 znaki";
        return;
      }
      if (content.length < 2) {
        errorEl.textContent = "Opinia musi mieć co najmniej 2 znaki";
        return;
      }

      submitBtn.disabled = true;

      try {
        const res = await fetch("/api/add-review", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            author,
            content,
            rating: Number(rating),
            email: email || undefined,
            website,
          }),
        });
        const data = (await res.json()) as { error?: string };
        if (res.ok) {
          markSubmitted();
          showSentState();
          window.scrollTo({ top: 0, behavior: "smooth" });
        } else {
          errorEl.textContent = data.error ?? "Wystąpił błąd, spróbuj ponownie";
          submitBtn.disabled = false;
        }
      } catch {
        errorEl.textContent = "Błąd połączenia z serwerem";
        submitBtn.disabled = false;
      }
    });
  </script>

  <style>
    .add-review__form {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
      max-width: 520px;
      width: 100%;
    }

    .add-review textarea {
      resize: none;
      min-height: 120px;
    }

    /* Sent: the form stays visible but inactive. */
    .add-review__form--sent {
      opacity: 0.5;
      pointer-events: none;
    }

    /* ── Star picker ─────────────────────────────────────────── */

    /* Radios are in reverse order (5 → 1) and the row is reversed back, so
       "checked ~ label" / "hover ~ label" also light up the lower stars. */
    .star-picker {
      display: flex;
      flex-direction: row-reverse;
      justify-content: flex-end;
      gap: 2px;
    }

    .star-picker input[type="radio"] {
      display: none;
    }

    .star-picker label {
      font-size: 2.2rem;
      color: var(--c-star-empty);
      cursor: pointer;
      transition: color 100ms ease;
      line-height: 1;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    .star-picker input:checked ~ label,
    .star-picker label:hover,
    .star-picker label:hover ~ label {
      color: var(--c-star);
    }
  </style>
</BaseLayout>
