---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Panel administratora"
  description="Willa Ewa – panel administratora"
  navigation={{ title: "Panel", link: "main-page" }}
>
  <meta name="robots" content="noindex" slot="head" />

  <!-- ══════════════════════════════ INFO ═══════════════════════════════ -->
  <section class="info">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Zarządzanie opiniami</span>
        <h2 class="section-title">Opinie z Google oraz ze strony</h2>
        <p class="section-lead">
          Panel administratora został stworzony aby uniknąć sytuacji, w której
          jakaś złośliwa opinia zostanie automatycznie dodana na stronę
          internetową. Każda opinia (z Google i ze strony) najpierw musi zostać
          zaakceptowana właśnie tutaj.
        </p>
      </div>
      <div class="info-content">
        <h3>Informacje</h3>
        <p>Wszystkie opinie mają jeden z następujących statusów:</p>
        <ul>
          <li>
            <div class="icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path
                  d="M8 8a3.5 3 0 0 1 3.5 -3h1a3.5 3 0 0 1 3.5 3a3 3 0 0 1 -2 3a3 4 0 0 0 -2 4"
                ></path>
                <path d="M12 19l0 .01"></path>
              </svg>
              <strong>Oczekująca</strong>
            </div>
            <p>
              Nowa opinia, czeka na decyzję administratora (nie wyświetla się na
              stronie).
            </p>
          </li>
          <li>
            <div class="icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                <path d="M9 12l2 2l4 -4"></path>
              </svg>
              <strong>Zaakceptowana</strong>
            </div>
            <p>Wyświetla się na stronie.</p>
          </li>
          <li>
            <div class="icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M4 7l16 0"></path><path d="M10 11l0 6"></path><path
                  d="M14 11l0 6"></path>
                <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path>
                <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path>
              </svg>
              <strong>Usunięta</strong>
            </div>
            <p>Opinia usunięta (nie wyświetla się na stronie).</p>
          </li>
        </ul>
        <p>
          Statusy wszystkich opini można dowolnie zmieniać. Jeżeli np. przez
          przypadek usunie się opinię, można ją przywrócić wchodząc w zakładkę
          usunięte.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ REVIEWS ═══════════════════════════════ -->
  <section class="reviews">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Panel opini</span>
        <h2 class="section-title">Oczekujące</h2>
        <p class="section-lead"></p>
      </div>
      <div class="status-filter" data-current-filter="pending">
        <button class="button-outline status-filter__btn--pending">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M8 8a3.5 3 0 0 1 3.5 -3h1a3.5 3 0 0 1 3.5 3a3 3 0 0 1 -2 3a3 4 0 0 0 -2 4"
            ></path>
            <path d="M12 19l0 .01"></path>
          </svg>
          Oczekujące
        </button>
        <button class="button-outline status-filter__btn--accepted">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
            <path d="M9 12l2 2l4 -4"></path>
          </svg>
          Zaakceptowane
        </button>
        <button class="button-outline status-filter__btn--deleted">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M4 7l16 0"></path><path d="M10 11l0 6"></path><path
              d="M14 11l0 6"></path>
            <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path>
            <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path>
          </svg>
          Usunięte
        </button>
        <button class="button-outline status-filter__btn--all">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M4 3h16"></path><path d="M4 9h16"></path>
            <path d="M4 15h16"></path><path d="M4 21h16"></path>
          </svg>
          Wszystkie
        </button>
      </div>
      <div class="reviews__grid"></div>
    </div>
    <button id="apply-changes" class="hidden">Zatwierdź zmiany:</button>
  </section>

  <!-- ══════════════════════════════ SANITY ═══════════════════════════════ -->
  <section class="sanity-cms">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Zarządzanie treścią</span>
        <h2 class="section-title">Sanity Studio</h2>
        <p class="section-lead">
          Edytuj treść strony — zdjęcia, opisy, dane kontaktowe.
        </p>
      </div>
      <div class="info-content">
        <p>
          Kliknij przycisk poniżej, aby otworzyć panel edycji treści w nowej
          karcie. W Sanity Studio możesz dodawać/kadrować/usuwać/zmieniać
          kolejność zdjęć pierwszej sekcji strony (sekcja "hero"), tam gdzie
          jest napis "Pokoje do wynajęcia w Krynicy Morskiej".Tak samo zdjęcia
          pokoi i z galeri zdjęć (w galeri możesz też dodawać opisy i linki pod
          zdjęciami). Aby zmienić kolejność zdjęć musisz przeciągnąć je
          trzymająć za ikonkę z sześcioma kropkami, która wyświetli się po
          najechaniu na zdjęcie. Możesz także zmieniać podstawowe informacje na
          stronie jak numer telefonu, cena itd.
        </p>
        <p>
          Po każdej zmianie treści strona automatycznie się przebuduje — może to
          potrwać około 1–2 minut.
        </p>
        <a
          href="https://www.sanity.io/@olDJ1uTaz/studio/pst2er4kcasxd158upm0ysmz/default/structure"
          target="_blank"
          rel="noopener noreferrer"
          class="sanity-link"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"
            ></path>
            <path d="M11 13l9 -9"></path><path d="M15 4h5v5"></path>
          </svg>
          Otwórz Sanity Studio
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ ANALYTICS ═══════════════════════════════ -->
  <section class="analytics">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Analityka strony</span>
        <h2 class="section-title">Ruch na stronie</h2>
        <p class="section-lead">
          Tu możesz zobaczyć ile osób wchodziło na stronę i dodatkowe statystyki
        </p>
      </div>
      <iframe src="https://cloud.umami.is/share/4lS7UlZQWCt7oA1n"></iframe>
    </div>
  </section>

  <script>
    // Auth guard — runs before any DOM manipulation or data fetching.
    // Treats ANY non-200 (including 404 from the Astro dev server when Express
    // is not proxied) and network errors as unauthorized so the redirect always fires.
    const verifyRes = await fetch("/api/auth/verify").catch(() => null);
    if (!verifyRes?.ok) {
      window.location.replace("/login");
      throw new Error("unauthorized"); // halts further module execution
    }

    type ReviewStatus = "pending" | "accepted" | "deleted";
    type StatusFilter = ReviewStatus | "all";

    interface Review {
      id: string;
      author: string;
      quote: string;
      rating: number;
      time: number;
      status: ReviewStatus;
      source: "google" | "page";
    }

    function formatDate(timestamp: number): string {
      return new Date(timestamp * 1000).toLocaleDateString("pl-PL", {
        year: "numeric",
        month: "long",
        day: "numeric",
      });
    }

    function getInitials(author: string): string {
      return author
        .split(" ")
        .map((w) => w[0] ?? "")
        .join("")
        .slice(0, 2)
        .toLowerCase();
    }

    function renderStars(rating: number): string {
      const full = Math.floor(rating);
      const half = rating % 1 >= 0.5;
      const empty = 5 - full - (half ? 1 : 0);
      return (
        '<div class="star star--filled"></div>'.repeat(full) +
        (half ? '<div class="star star--half"></div>' : "") +
        '<div class="star"></div>'.repeat(empty)
      );
    }

    let currentStatusFilter: StatusFilter = "pending";
    const reviewsSectionTitle = document.querySelector(
      ".reviews .section-title",
    );
    const statusFilterElement = document.querySelector(".status-filter");
    const reviewsContainerElement = document.querySelector(".reviews__grid")!;

    const statusNamePl: Record<StatusFilter, string> = {
      all: "Wszystkie",
      pending: "Oczekujące",
      accepted: "Zaakceptowane",
      deleted: "Usunięte",
    };

    const pendingChanges = new Map<string, ReviewStatus>();
    const applyChangesButton = document.querySelector("#apply-changes")!;
    applyChangesButton.addEventListener("click", () => applyChanges());

    statusFilterElement?.addEventListener("click", (e) => {
      const button = (e.target as HTMLElement).closest("button");
      if (!button) return;
      if (button.classList.contains("status-filter__btn--pending"))
        changeStatusFilter("pending");
      else if (button.classList.contains("status-filter__btn--accepted"))
        changeStatusFilter("accepted");
      else if (button.classList.contains("status-filter__btn--deleted"))
        changeStatusFilter("deleted");
      else if (button.classList.contains("status-filter__btn--all"))
        changeStatusFilter("all");
    });

    function changeStatusFilter(filter: StatusFilter) {
      if (currentStatusFilter === filter) return;
      currentStatusFilter = filter;
      statusFilterElement?.setAttribute("data-current-filter", filter);
      if (reviewsSectionTitle)
        reviewsSectionTitle.textContent = statusNamePl[filter];
      renderReviews();
    }

    async function fetchReviews(): Promise<Review[]> {
      const res = await fetch("/api/admin/get-reviews");
      if (!res.ok) {
        if (res.status === 401 || res.status === 403) {
          window.location.replace("/login");
          throw new Error("Unauthorized");
        }
        alert("Błąd podczas pobierania opini z serwera");
        throw new Error("Błąd pobierania recenzji");
      }
      const data = (await res.json()) as { reviews: Review[] };
      return data.reviews;
    }

    let allReviews = await fetchReviews();
    renderReviews();

    function renderReviews() {
      const filtered =
        currentStatusFilter === "all"
          ? allReviews
          : allReviews.filter((r) => r.status === currentStatusFilter);
      reviewsContainerElement.innerHTML = filtered.length
        ? filtered.map(renderReview).join("")
        : `<p class="reviews__empty">Brak opinii z tym statusem</p>`;
    }

    reviewsContainerElement.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      const toggleBtn = target.closest(".review-toggle") as HTMLElement | null;
      if (toggleBtn) {
        const quote = toggleBtn.previousElementSibling;
        const expanded = quote?.classList.toggle("expanded");
        toggleBtn.textContent = expanded ? "Zwiń" : "Czytaj więcej";
        return;
      }

      const hardDeleteBtn = target.closest(
        ".review-card__hard-delete",
      ) as HTMLElement | null;
      if (hardDeleteBtn) {
        const card = hardDeleteBtn.closest(".review-card") as HTMLElement;
        const id = card?.dataset.id;
        const review = allReviews.find((r) => r.id === id);
        if (review) showDeleteConfirm(review);
        return;
      }

      const statusBtn = target.closest(
        "[class*='status-picker__btn']",
      ) as HTMLElement | null;
      if (!statusBtn) return;

      const card = statusBtn.closest(".review-card") as HTMLElement;
      if (!card) return;

      const id = card.dataset.id;
      let newStatus: ReviewStatus | null = null;
      if (statusBtn.classList.contains("status-picker__btn--accepted"))
        newStatus = "accepted";
      else if (statusBtn.classList.contains("status-picker__btn--pending"))
        newStatus = "pending";
      else if (statusBtn.classList.contains("status-picker__btn--deleted"))
        newStatus = "deleted";

      if (newStatus && id) {
        const review = allReviews.find((r) => r.id === id);
        if (!review) return;
        if (newStatus === review.status) {
          pendingChanges.delete(id);
          card.removeAttribute("data-pending-status");
        } else {
          pendingChanges.set(id, newStatus);
          card.setAttribute("data-pending-status", newStatus);
        }
      }
      updateApplyButton();
    });

    function updateApplyButton() {
      const count = pendingChanges.size;
      if (count === 0) {
        applyChangesButton.classList.add("hidden");
      } else {
        applyChangesButton.classList.remove("hidden");
        applyChangesButton.textContent = `Zatwierdź zmiany: ${count} ${count === 1 ? "opinia" : count < 5 ? "opinie" : "opinii"}`;
      }
    }

    async function applyChanges() {
      if (pendingChanges.size === 0) return;
      const changes = Array.from(pendingChanges, ([id, status]) => ({
        id,
        status,
      }));
      const res = await fetch("/api/admin/change-statuses", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ reviews: changes }),
      });
      if (!res.ok) {
        alert("Błąd zapisywania zmian");
        return;
      }
      for (const [id, status] of pendingChanges) {
        const review = allReviews.find((r) => r.id === id);
        if (review) review.status = status;
      }
      pendingChanges.clear();
      updateApplyButton();
      renderReviews();
      alert("Udało się zaktualizować status opini");
    }

    function showDeleteConfirm(review: Review): void {
      document.querySelector(".delete-confirm-overlay")?.remove();
      const overlay = document.createElement("div");
      overlay.className = "delete-confirm-overlay";
      overlay.innerHTML = `
        <div class="delete-confirm-dialog">
          <h3>Czy na pewno chcesz usunąć tę opinię?</h3>
          <div class="delete-confirm-details">
            <table>
              <tr><td>Autor</td><td><strong>${review.author}</strong></td></tr>
              <tr><td>Ocena</td><td><div class="stars">${renderStars(review.rating)}</div></td></tr>
              <tr><td>Data</td><td>${formatDate(review.time)}</td></tr>
              <tr><td>Treść</td><td class="delete-confirm-details__quote">${review.quote}</td></tr>
            </table>
          </div>
          <p class="delete-confirm-warning">Tej operacji nie można cofnąć.</p>
          <div class="delete-confirm-actions">
            <button class="delete-confirm__no">Nie</button>
            <button class="delete-confirm__yes">Tak, usuń trwale</button>
          </div>
        </div>
      `;
      overlay
        .querySelector(".delete-confirm__no")
        ?.addEventListener("click", () => overlay.remove());
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) overlay.remove();
      });
      overlay
        .querySelector(".delete-confirm__yes")
        ?.addEventListener("click", async () => {
          await permanentlyDeleteReview(review.id);
          overlay.remove();
        });
      document.body.appendChild(overlay);
    }

    async function permanentlyDeleteReview(id: string): Promise<void> {
      const res = await fetch(`/api/admin/reviews/${id}`, { method: "DELETE" });
      if (!res.ok) {
        alert("Błąd podczas usuwania opinii");
        return;
      }
      allReviews = allReviews.filter((r) => r.id !== id);
      renderReviews();
    }

    function renderReview(review: Review): string {
      const pendingStatus = pendingChanges.get(review.id);
      const pendingAttr = pendingStatus
        ? `data-pending-status="${pendingStatus}"`
        : "";
      const isLong = review.quote.length > 450;

      return `
        <div class="review-card${isLong ? " long-quote" : ""}" data-status="${review.status}" data-id="${review.id}" ${pendingAttr}>
          <div class="review-card__source">
            <div class="review-card__source-logo-wrap">
              <div class="review-card__source-logo">
                ${
                  review.source === "google"
                    ? `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 2a9.96 9.96 0 0 1 6.29 2.226a1 1 0 0 1 .04 1.52l-1.51 1.362a1 1 0 0 1 -1.265 .06a6 6 0 1 0 2.103 6.836l.001 -.004h-3.66a1 1 0 0 1 -.992 -.883l-.007 -.117v-2a1 1 0 0 1 1 -1h6.945a1 1 0 0 1 .994 .89c.04 .367 .061 .737 .061 1.11c0 5.523 -4.477 10 -10 10s-10 -4.477 -10 -10s4.477 -10 10 -10z"/></svg>`
                    : `<img src="/favicon/favicon.svg" width="24" height="24" alt="Willa Ewa" />`
                }
              </div>
              <span class="review-card__source-name">${review.source === "google" ? "Google" : "Strona"}</span>
            </div>
            <div class="review-card__stars">${renderStars(review.rating)}</div>
          </div>
          ${review.quote ? `<blockquote class="review-card__quote">„${review.quote}"</blockquote>` : ""}
          <button class="review-toggle">Czytaj więcej</button>
          <div class="review-card__bottom">
            <div class="review-card__author">
              <div class="review-card__avatar" aria-hidden="true">${getInitials(review.author)}</div>
              <div>
                <p class="review-card__name">${review.author}</p>
                <p class="review-card__date">${formatDate(review.time)}</p>
              </div>
            </div>
            <div class="review-card__controls">
              <div class="status-picker">
                <button class="status-picker__btn--accepted">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/><path d="M9 12l2 2l4 -4"/></svg>
                </button>
                <button class="status-picker__btn--pending">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 8a3.5 3 0 0 1 3.5 -3h1a3.5 3 0 0 1 3.5 3a3 3 0 0 1 -2 3a3 4 0 0 0 -2 4"/><path d="M12 19l0 .01"/></svg>
                </button>
                <button class="status-picker__btn--deleted">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 7l16 0"/><path d="M10 11l0 6"/><path d="M14 11l0 6"/><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"/><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"/></svg>
                </button>
              </div>
            </div>
          </div>
          ${
            currentStatusFilter === "deleted" && review.source === "page"
              ? `<button class="review-card__hard-delete">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 7h16"/><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"/><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"/><path d="M10 12l4 4m0 -4l-4 4"/></svg>
                  Usuń trwale
                </button>`
              : ""
          }
        </div>
      `;
    }
  </script>

  <style is:global>
    /* ── Info section ─────────────────────────────────────────── */
    .info {
      margin-block-start: var(--space-xl);
    }

    .info .section-header {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .info-content {
      margin-top: var(--space-xl);
    }

    .info-content h3 {
      font-size: var(--font-size-xl);
      font-family: var(--font-serif);
      font-weight: var(--weight-light);
      margin: 0;
    }

    .info-content > p {
      font-size: var(--font-size-m);
      color: var(--c-font-secondary);
    }

    .info-content ul {
      list-style: none;
      margin: 0;
      padding: 0;
      margin-block: var(--space-l);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: start;
      gap: var(--space-s);
    }

    .info-content li {
      margin: 0;
      padding: var(--space-m);
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: start;
      border: 1px solid var(--c-font-primary);
    }

    .info-content .icon {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 8px;
    }

    .info-content li p {
      margin-inline-start: var(--space-xl);
    }

    /* ── Status filter ────────────────────────────────────────── */
    .status-filter {
      border-bottom: 1px solid var(--c-border-light);
      padding-bottom: 16px;
      display: grid;
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
      gap: 8px;
    }

    .status-filter .button-outline {
      padding: 12px;
      border: 1px solid var(--c-border-light);
      color: var(--c-border-light);
      display: flex;
      flex-direction: row;
      gap: 4px;
      justify-content: center;
      align-items: center;
    }

    .status-filter[data-current-filter="pending"] .status-filter__btn--pending,
    .status-filter[data-current-filter="accepted"]
      .status-filter__btn--accepted,
    .status-filter[data-current-filter="deleted"] .status-filter__btn--deleted,
    .status-filter[data-current-filter="all"] .status-filter__btn--all {
      border: 1px solid var(--c-font-accent);
      color: var(--c-font-primary);
      box-shadow: 0px 1px 2px var(--c-font-accent);
    }

    .reviews__empty {
      color: var(--c-font-secondary);
      margin-block-start: var(--space-l);
    }

    /* ── Reviews section ──────────────────────────────────────── */
    .reviews {
      background-color: var(--c-bg-secondary);
      padding-bottom: 200px;
      border-bottom: 1px solid var(--c-border-light);
    }

    .reviews__grid {
      margin-block-start: 32px;
      display: flex;
      flex-direction: column;
      gap: var(--space-l);
    }

    /* ── Review card base ─────────────────────────────────────── */
    .review-card {
      border: 1px solid var(--c-font-accent);
      padding: 32px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-l);
    }

    .review-card[data-pending-status] {
      border: 1px solid var(--c-font-primary);
    }

    .review-card__source {
      display: flex;
      width: 100%;
      justify-content: space-between;
      align-items: start;
      font-size: var(--font-size-s);
      color: var(--c-font-secondary);
    }

    .review-card__source-logo-wrap {
      display: flex;
      flex-direction: row;
      gap: 8px;
      justify-content: center;
      align-items: center;
    }

    .review-card__stars {
      display: flex;
      gap: 2px;
    }

    .star {
      width: 18px;
      height: 18px;
      background: var(--c-star-empty);
      clip-path: polygon(
        50% 0%,
        61% 35%,
        98% 35%,
        68% 57%,
        79% 91%,
        50% 70%,
        21% 91%,
        32% 57%,
        2% 35%,
        39% 35%
      );
    }

    .star--filled {
      background: var(--c-star);
    }

    .star--half {
      background: linear-gradient(
        to right,
        var(--c-star) 50%,
        var(--c-star-empty) 50%
      );
    }

    .review-card__quote {
      font-family: var(--font-serif);
      font-weight: var(--weight-light);
    }

    .review-card.long-quote .review-card__quote {
      overflow: hidden;
      max-height: 6.5rem;
      transition: max-height 250ms ease-out;
    }

    .review-card.long-quote .expanded {
      max-height: 1000px;
    }

    .review-card:not(.long-quote) .review-toggle {
      display: none;
    }

    .review-card.long-quote .review-toggle {
      align-self: flex-end;
      background: none;
      border: 1px solid var(--c-font-accent);
      color: var(--c-font-accent);
      padding: 8px 16px;
      cursor: pointer;
    }

    /* ── Review card bottom (admin-specific) ──────────────────── */
    .review-card__bottom {
      border-top: 1px solid var(--c-border-light);
      padding-top: 16px;
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: start;
      gap: 16px;
    }

    @media (min-width: 780px) {
      .review-card__bottom {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
    }

    .review-card__author {
      border: none;
      font-size: var(--font-size-s);
      display: flex;
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      gap: 16px;
    }

    .review-card__name {
      font-weight: var(--weight-bold);
      text-transform: capitalize;
    }

    .review-card__date {
      font-weight: var(--weight-light);
      font-size: var(--font-size-s);
    }

    .review-card__avatar {
      background-color: hsl(32, 26%, 73%);
      color: var(--c-font-light);
      font-weight: var(--weight-medium);
      font-family: var(--font-serif);
      font-size: var(--font-size-m);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      height: 4ch;
      aspect-ratio: 1/1;
      border-radius: 50%;
      text-transform: uppercase;
    }

    .review-card__controls {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 8px;
      width: 100%;
    }

    @media (min-width: 780px) {
      .review-card__controls {
        width: fit-content;
      }
    }

    /* ── Status picker ────────────────────────────────────────── */
    .status-picker {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      flex: 1;
      gap: 8px;
    }

    @media (min-width: 780px) {
      .status-picker {
        flex: unset;
        width: fit-content;
      }
    }

    .status-picker button {
      padding: 12px;
      background-color: transparent;
      border: 1px solid transparent;
      color: var(--c-border-light);
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .status-picker button svg {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .review-card[data-status="accepted"] .status-picker__btn--accepted,
    .review-card[data-status="pending"] .status-picker__btn--pending,
    .review-card[data-status="deleted"] .status-picker__btn--deleted {
      border: 1px solid var(--c-border-light);
    }

    .review-card[data-pending-status="accepted"] .status-picker__btn--accepted,
    .review-card[data-pending-status="pending"] .status-picker__btn--pending,
    .review-card[data-pending-status="deleted"] .status-picker__btn--deleted {
      border: 1px solid var(--c-font-accent);
      color: var(--c-font-primary);
      box-shadow: 0px 1px 2px var(--c-font-accent);
    }

    /* ── Hard delete button ───────────────────────────────────── */
    .review-card__hard-delete {
      align-self: flex-end;
      padding: 6px 12px;
      background-color: transparent;
      border: 1px solid var(--c-border-light);
      color: var(--c-font-secondary);
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: var(--font-size-s);
      cursor: pointer;
      transition:
        color 0.15s,
        border-color 0.15s;
    }

    .review-card__hard-delete:hover {
      border-color: #c0392b;
      color: #c0392b;
    }

    /* ── Apply changes button (fixed) ────────────────────────── */
    #apply-changes {
      background-color: var(--c-bg-dark);
      border: 1px solid var(--c-font-primary);
      color: var(--c-font-light);
      position: fixed;
      bottom: 1.5rem;
      left: 1.5rem;
      right: 1.5rem;
      max-width: 400px;
      margin: 0 auto;
      padding-block: 18px;
      cursor: pointer;
    }

    .hidden {
      display: none;
    }

    /* ── Delete confirmation dialog ───────────────────────────── */
    .delete-confirm-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(4px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      animation: overlay-in 0.2s ease forwards;
    }

    @keyframes overlay-in {
      from {
        opacity: 0;
        backdrop-filter: blur(0px);
      }
      to {
        opacity: 1;
        backdrop-filter: blur(4px);
      }
    }

    .delete-confirm-dialog {
      background: var(--c-bg-primary);
      border: 1px solid var(--c-border-light);
      padding: 2rem;
      max-width: 480px;
      width: 100%;
    }

    .delete-confirm-dialog h3 {
      font-family: var(--font-serif);
      font-weight: var(--weight-light);
      font-size: var(--font-size-xl);
      margin: 0 0 1.5rem;
    }

    .delete-confirm-details {
      margin-bottom: 1rem;
    }

    .delete-confirm-details table {
      border-collapse: collapse;
      width: 100%;
    }

    .delete-confirm-details td {
      padding: 4px 12px 4px 0;
      font-size: var(--font-size-s);
      vertical-align: top;
    }

    .delete-confirm-details td:first-child {
      color: var(--c-font-secondary);
      white-space: nowrap;
    }

    .delete-confirm-details .stars {
      display: flex;
      gap: 2px;
    }

    .delete-confirm-details__quote {
      max-width: 320px;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }

    .delete-confirm-warning {
      color: #c0392b;
      font-size: var(--font-size-s);
      margin: 0 0 1.5rem;
    }

    .delete-confirm-actions {
      display: flex;
      gap: 8px;
      justify-content: flex-end;
    }

    .delete-confirm__no {
      padding: 10px 24px;
      border: 1px solid var(--c-border-light);
      background: transparent;
      color: var(--c-font-primary);
      cursor: pointer;
    }

    .delete-confirm__yes {
      padding: 10px 24px;
      border: 1px solid #c0392b;
      background: #c0392b;
      color: #fff;
      cursor: pointer;
    }

    /* ── Sanity CMS ───────────────────────────────────────────── */
    .sanity-cms {
      background-color: var(--c-bg-primary);
    }

    .sanity-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: var(--space-l);
      padding: 14px 24px;
      background-color: var(--c-bg-dark);
      border: 1px solid var(--c-font-primary);
      color: var(--c-font-light);
      font-size: var(--font-size-m);
      font-family: var(--font-sans-serif);
      text-decoration: none;
      transition: opacity 150ms ease;
    }

    .sanity-link:hover {
      opacity: 0.85;
      transform: none;
    }

    /* ── Analytics ────────────────────────────────────────────── */
    .analytics {
      background-color: var(--c-bg-secondary);
    }

    .analytics iframe {
      width: 100%;
      height: 800px;
    }
  </style>
</BaseLayout>
