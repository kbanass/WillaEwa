/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://cdn.sanity.io; connect-src 'self' https://csed1mdo.api.sanity.io https://cloud.umami.is https://gateway.umami.is https://cloudflareinsights.com; frame-src https://cloud.umami.is;

/api/*
  Cache-Control: no-store

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
