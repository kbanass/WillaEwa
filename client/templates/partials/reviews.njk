{% for review in reviews %}
<div class="review-card {{ 'long-quote' if review.quote | length > 450 }}" data-id="{{review.id}}">
  <div class="review-card__source">
    <div class="review-card__source-logo-wrap">
      {% if review.source == 'google' %}
      <div class="review-card__source-logo logo-google">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 2a9.96 9.96 0 0 1 6.29 2.226a1 1 0 0 1 .04 1.52l-1.51 1.362a1 1 0 0 1 -1.265 .06a6 6 0 1 0 2.103 6.836l.001 -.004h-3.66a1 1 0 0 1 -.992 -.883l-.007 -.117v-2a1 1 0 0 1 1 -1h6.945a1 1 0 0 1 .994 .89c.04 .367 .061 .737 .061 1.11c0 5.523 -4.477 10 -10 10s-10 -4.477 -10 -10s4.477 -10 10 -10z"/>
        </svg>
      </div>
      <span class="review-card__source-name">Google</span>
      {% else %}
      <div class="review-card__source-logo logo-site">
        review.source
      </div>
      <span class="review-card__source-name">Opinia własna</span>
      {% endif %}
    </div>

    <div class="review-card__stars">
      {% for i in range(review.fullStars) %}
      <div class="star star--filled"></div>
      {% endfor %}
      {% if review.halfStar %}
      <div class="star star--half"></div>
      {% endif %}
      {% for i in range(review.emptyStars) %}
      <div class="star"></div>
      {% endfor %}
    </div>
  </div>

  {% if review.quote %}
  <blockquote class="review-card__quote">
    „{{ review.quote }}"
  </blockquote>
  {% endif %}
  <button class="review-toggle">Czytaj więcej</button>

  <div class="review-card__author">
    <div class="review-card__avatar" aria-hidden="true">
      {{ review.initials }}
    </div>
    <div>
      <p class="review-card__name">{{ review.author }}</p>
      <p class="review-card__date">{{ review.date }}</p>
    </div>
  </div>
</div>
{% endfor %}